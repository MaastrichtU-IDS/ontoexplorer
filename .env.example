# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ontoexplorer
POSTGRES_USER=ontoexplorer
POSTGRES_PASSWORD=ontoexplorer
DATABASE_URL=postgresql+asyncpg://ontoexplorer:ontoexplorer@postgres:5432/ontoexplorer

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ONTOLOGIES=ontologies

# ── SPARQL metadata store (Fuseki) ───────────────────────────────────────────
QLEVER_ENDPOINT=http://qlever:3030/qlever
QLEVER_SPARQL_PATH=/sparql
QLEVER_UPDATE_USER=admin
QLEVER_UPDATE_PASSWORD=admin

# ── Pyoxigraph (embedded triplestore) ────────────────────────────────────────
OXIGRAPH_DATA_PATH=/data/oxigraph

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Inbound GitHub webhook ────────────────────────────────────────────────────
# Set to the secret configured in the GitHub repo Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# ── OAuth — Google ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — ORCID ─────────────────────────────────────────────────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_SANDBOX=false

# ── Frontend / Auth settings ──────────────────────────────────────────────────
# URL where the React SPA is served — used for post-OAuth redirects
FRONTEND_URL=http://localhost:5173
# Public URL of the API — used to build OAuth callback URIs
APP_URL=http://localhost:8000
# Set to true to skip OAuth login in local development (creates a dev@localhost user)
AUTH_BYPASS=false

# ── ELK service ───────────────────────────────────────────────────────────────
ELK_SERVICE_URL=http://elk-service:8001
ELK_SERVICE_TIMEOUT=3600

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
LOKI_URL=http://loki:3100

# ── Admin panel ───────────────────────────────────────────────────────────────
# Comma-separated email addresses that can access /admin
ADMIN_EMAILS=

# ── MOD-API ───────────────────────────────────────────────────────────────────
MOD_CATALOGUE_TITLE=OntoExplorer Catalogue
MOD_CATALOGUE_DESCRIPTION=A FAIR ontology repository
# Rate limits for /mod/* endpoints (requests per day)
MOD_RATE_LIMIT_ANON=1000
MOD_RATE_LIMIT_AUTH=10000
