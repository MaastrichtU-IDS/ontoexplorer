# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ontoexplorer
POSTGRES_USER=ontoexplorer
POSTGRES_PASSWORD=ontoexplorer
DATABASE_URL=postgresql+asyncpg://ontoexplorer:ontoexplorer@postgres:5432/ontoexplorer

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_ONTOLOGIES=ontologies

# ── QLever (SPARQL triplestore) ───────────────────────────────────────────────
QLEVER_URL=http://qlever:7001

# ── Pyoxigraph (embedded triplestore) ────────────────────────────────────────
OXIGRAPH_DATA_PATH=/data/oxigraph

# ── Auth / OIDC ───────────────────────────────────────────────────────────────
OIDC_ISSUER=https://your-oidc-provider.example.com
OIDC_CLIENT_ID=ontoexplorer
OIDC_CLIENT_SECRET=change-me
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── ELK service (Phase 6) ─────────────────────────────────────────────────────
ELK_SERVICE_URL=http://elk-service:8001

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
LOKI_URL=http://loki:3100
