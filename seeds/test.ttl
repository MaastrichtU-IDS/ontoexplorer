@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .

<http://purl.obolibrary.org/obo/test.owl>
    rdf:type owl:Ontology ;
    rdfs:label "Test Ontology" .

# ── Object properties ─────────────────────────────────────────────────────────

obo:TEST_0000006 rdf:type owl:ObjectProperty ;
    rdfs:label "has part" .

obo:TEST_0000007 rdf:type owl:ObjectProperty ;
    rdfs:label "caused by" .

# ── Named classes ─────────────────────────────────────────────────────────────

obo:TEST_0000001 rdf:type owl:Class ;
    rdfs:label "cell" ;
    oboInOwl:hasExactSynonym "biological cell" .

obo:TEST_0000002 rdf:type owl:Class ;
    rdfs:label "cell death" ;
    oboInOwl:hasExactSynonym "cellular death" ;
    rdfs:subClassOf obo:TEST_0000001 .

obo:TEST_0000003 rdf:type owl:Class ;
    rdfs:label "apoptosis" ;
    rdfs:subClassOf obo:TEST_0000002 ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty obo:TEST_0000007 ;
        owl:someValuesFrom obo:TEST_0000001
    ] .

obo:TEST_0000004 rdf:type owl:Class ;
    rdfs:label "nucleus" .

# nucleated cell = cell that has part some nucleus
obo:TEST_0000005 rdf:type owl:Class ;
    rdfs:label "nucleated cell" ;
    rdfs:subClassOf obo:TEST_0000001 ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty obo:TEST_0000006 ;
        owl:someValuesFrom obo:TEST_0000004
    ] .

# nucleated dying cell = cell death AND has part some nucleus
obo:TEST_0000008 rdf:type owl:Class ;
    rdfs:label "nucleated dying cell" ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            obo:TEST_0000002
            [
                rdf:type owl:Restriction ;
                owl:onProperty obo:TEST_0000006 ;
                owl:someValuesFrom obo:TEST_0000004
            ]
        )
    ] .

# cell death or apoptosis (union)
obo:TEST_0000009 rdf:type owl:Class ;
    rdfs:label "cell death or apoptosis" ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (
            obo:TEST_0000002
            obo:TEST_0000003
        )
    ] .
