@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix obo:        <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl:   <http://www.geneontology.org/formats/oboInOwl#> .

<http://purl.obolibrary.org/obo/cco.owl>
    a owl:Ontology ;
    rdfs:label "Cell Component Ontology" .

# ── Object properties ─────────────────────────────────────────────────────────

obo:CCO_0000001 a owl:ObjectProperty ;
    rdfs:label "has component" .

obo:CCO_0000002 a owl:ObjectProperty ;
    rdfs:label "part of" .

# ── Classes ───────────────────────────────────────────────────────────────────

# Shared concept: cell (same label as TEST_0000001, different IRI)
obo:CCO_0000003 a owl:Class ;
    rdfs:label "cell" ;
    oboInOwl:hasExactSynonym "biological cell" .

# New: cellular component hierarchy
obo:CCO_0000004 a owl:Class ;
    rdfs:label "cellular component" .

obo:CCO_0000005 a owl:Class ;
    rdfs:label "organelle" ;
    rdfs:subClassOf obo:CCO_0000004 .

obo:CCO_0000006 a owl:Class ;
    rdfs:label "membrane-bound organelle" ;
    rdfs:subClassOf obo:CCO_0000005 .

# Shared concept: nucleus (same label as TEST_0000004, different IRI)
obo:CCO_0000007 a owl:Class ;
    rdfs:label "nucleus" ;
    oboInOwl:hasExactSynonym "cell nucleus" ;
    rdfs:subClassOf obo:CCO_0000006 ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty obo:CCO_0000002 ;       # part of
        owl:someValuesFrom obo:CCO_0000003     # cell
    ] .

obo:CCO_0000008 a owl:Class ;
    rdfs:label "mitochondrion" ;
    oboInOwl:hasExactSynonym "mitochondria" ;
    rdfs:subClassOf obo:CCO_0000006 .

obo:CCO_0000009 a owl:Class ;
    rdfs:label "cytoplasm" ;
    rdfs:subClassOf obo:CCO_0000004 ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty obo:CCO_0000002 ;       # part of
        owl:someValuesFrom obo:CCO_0000003     # cell
    ] .

# Shared concept: cell death (same label as TEST_0000002, different IRI)
obo:CCO_0000010 a owl:Class ;
    rdfs:label "cell death" ;
    oboInOwl:hasExactSynonym "cellular death" .

# Shared concept: apoptosis (same label as TEST_0000003, different IRI)
obo:CCO_0000011 a owl:Class ;
    rdfs:label "apoptosis" ;
    oboInOwl:hasExactSynonym "programmed cell death" ;
    rdfs:subClassOf obo:CCO_0000010 .

# New: necrosis — a different type of cell death not in TEST ontology
obo:CCO_0000012 a owl:Class ;
    rdfs:label "necrosis" ;
    oboInOwl:hasExactSynonym "accidental cell death" ;
    rdfs:subClassOf obo:CCO_0000010 .

# Shared concept: nucleated cell (same label as TEST_0000005, different IRI)
# Here defined with has component instead of has part
obo:CCO_0000013 a owl:Class ;
    rdfs:label "nucleated cell" ;
    rdfs:subClassOf obo:CCO_0000003 ;          # subClassOf cell
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty obo:CCO_0000001 ;       # has component
        owl:someValuesFrom obo:CCO_0000007     # nucleus
    ] .

# New: enucleated cell — a cell explicitly lacking a nucleus
obo:CCO_0000014 a owl:Class ;
    rdfs:label "enucleated cell" ;
    rdfs:subClassOf obo:CCO_0000003 ;
    owl:disjointWith obo:CCO_0000013 .         # disjoint with nucleated cell

# New: dying nucleated cell — equivalent class expression using CCO properties
obo:CCO_0000015 a owl:Class ;
    rdfs:label "dying nucleated cell" ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            obo:CCO_0000010                    # cell death
            [
                a owl:Restriction ;
                owl:onProperty obo:CCO_0000001 ;   # has component
                owl:someValuesFrom obo:CCO_0000007  # nucleus
            ]
        )
    ] .
