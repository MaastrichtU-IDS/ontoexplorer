# Native linux/arm64 build of the reasoner service.
#
# Why this exists: the default (amd64) image runs emulated on Apple Silicon, so
# classification is slow and the emulated stack has been a source of crashes.
# This image builds everything for aarch64 so the reasoners run NATIVELY.
#
# Reasoner coverage in this image (all native aarch64):
#   - rustdl  : PyPI aarch64 wheel (see the pinned version below). Default, and
#               the justifier for every reasoner.
#   - konclude: compiled from source for aarch64 (see konclude-build stage). We
#               only ever feed it OWL/XML, so KoncludeWithoutRedland.pro (pure
#               Qt, no RDF parser) is sufficient — no static Redland stack, no
#               qemu emulation, no locale workarounds.
#   - km      : kobayashi-marust, compiled from source for aarch64 (km-build
#               stage). Rust, links only libc/libgcc. Classify + consistency.
#
# py-horned-owl has no glibc/manylinux aarch64 wheel on PyPI, so it is compiled
# from sdist in a Rust builder stage below.

# --- builder: compile py-horned-owl (Rust) into an aarch64 wheel ---
# MUST use the same Python (3.12) as the final image: py-horned-owl builds a
# version-specific extension (cp312 tag), not abi3, so a cp311 wheel from a
# python-3.11 builder would be rejected by python:3.12-slim.
FROM python:3.12-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
RUN pip install --no-cache-dir maturin
# Produces /wheels/py_horned_owl-1.4.*-cp312-...aarch64.whl (build backend: maturin).
RUN pip wheel --no-cache-dir "py-horned-owl==1.4.*" -w /wheels

# --- konclude: compile natively for aarch64 (Qt-only, no Redland) ---
# Konclude is portable C++/Qt5; the upstream release does a heavyweight STATIC
# build (static Qt + static Redland) only for cross-distro portability. Inside
# this one container we just dynamically link apt's Qt5, and since the backend
# feeds only OWL/XML we build KoncludeWithoutRedland.pro (drops libxml2/raptor2/
# rasqal/redland entirely). Verified to classify correctly on aarch64.
FROM python:3.12-slim-bookworm AS konclude-build
ARG KONCLUDE_TAG=v0.7.0-1138
# libgl-dev: KoncludeWithoutRedland.pro keeps Qt's default `gui` module, which
# links -lGL at the final link. python:slim-bookworm + qtbase5-dev doesn't pull
# libGL in (the ubuntu spike image did), so the link fails without it.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates build-essential qtbase5-dev qtbase5-dev-tools libgl-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${KONCLUDE_TAG}" https://github.com/konclude/Konclude.git /src
WORKDIR /src
# make -j1 (not -jnproc): Konclude is template-heavy C++ and a single TU can use
# 1-2 GB; any parallelism OOM-kills g++ inside the default ~7.7 GB Docker VM when
# the app stack is also running. -j1 caps peak memory to one compile and builds
# reliably regardless of what else is up. It's slow (~10 min) but this is a
# cached layer that only rebuilds when this stage changes.
RUN printf '#define KONCLUDE_VERSION_GIT_REVISION_NUMBER 1138\n#define KONCLUDE_VERSION_GIT_TAG_NAME_STRING "v0.7.0"\n#define KONCLUDE_VERSION_GIT_REVISION_HASH_STRING "release"\n' > revision-git.h \
 && qmake -r CONFIG+=release CONFIG-=debug KoncludeWithoutRedland.pro \
 && make -j1
# Separate layer so the ~10 min compile above stays cached across copy tweaks.
# qmake's DESTDIR is `Release` (capital); find is case-robust either way.
RUN cp "$(find /src -type f -name Konclude -path '*[Rr]elease*' | head -1)" /Konclude

# --- km-build: compile kobayashi-marust's `km` binary natively for aarch64 ---
FROM rust:1-slim-bookworm AS km-build
ARG KM_REV=v1.3.0
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/bio-ontology-research-group/kobayashi-marust.git /src \
 && cd /src && git checkout "${KM_REV}"
WORKDIR /src/engine
RUN cargo build --release --bin km && cp target/release/km /km

# --- final image ---
FROM python:3.12-slim-bookworm
WORKDIR /app

# py-horned-owl compiled to an aarch64 wheel by the builder stage (km/konclude use
# open_ontology_from_string). whelk removed — py-whelk segfaulted here.
COPY --from=builder /wheels/py_horned_owl-*.whl /tmp/wheels/
RUN pip install --no-cache-dir \
    "fastapi==0.111.*" \
    "uvicorn[standard]" \
    "rdflib" \
    "redis>=5.0" \
    "requests>=2.31" \
    /tmp/wheels/py_horned_owl-*.whl \
    "pyoxigraph>=0.4" \
    "rustdl==0.4.28" \
 && rm -rf /tmp/wheels

# Konclude (native aarch64): the binary dynamically links the Qt5 runtime libs
# it was built against (Core/Xml/Network/Concurrent). shutil.which finds it on
# PATH and konclude_backend runs `classification -i -o` as a normal subprocess.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libqt5core5a libqt5xml5 libqt5network5 libqt5concurrent5 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=konclude-build /Konclude /usr/local/bin/Konclude
RUN chmod +x /usr/local/bin/Konclude

# km (native aarch64 binary; links only libc/libgcc, already present).
COPY --from=km-build /km /usr/local/bin/km
RUN chmod +x /usr/local/bin/km

COPY main.py classify_worker.py consistency_worker.py justify_worker.py classifier.py cache.py \
     registry.py rustdl_backend.py konclude_backend.py km_backend.py incremental_km.py ./

EXPOSE 8001

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
