@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <http://example.org/rolecycle#> .

: a owl:Ontology .

# Forbidden in OWL 2 DL: a transitive property that is a sub-property of itself
# forms a role hierarchy cycle.
:p a owl:TransitiveProperty, owl:ObjectProperty ;
   rdfs:subPropertyOf :p .
