@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/baddatatype#> .

: a owl:Ontology .

# xsd:ID is an XML-specific identifier type, not in any OWL 2 datatype map
# (strict W3C §4.2 nor ecosystem extension). Genuinely invalid.
:A a owl:Class .
:a1 a :A ;
    :hasIdentifier "xyz"^^xsd:ID .
