@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix :     <http://example.org/ql-conformant#> .

# A minimal OWL 2 QL-conformant ontology.
# Contains only named classes, SubClassOf axioms, and a simple object property.
# No forbidden constructs: no cardinality (any), no TransitiveProperty,
# no FunctionalProperty, no unionOf, no hasValue, etc.

: a owl:Ontology .

:Animal  a owl:Class .
:Mammal  a owl:Class ; rdfs:subClassOf :Animal .
:Dog     a owl:Class ; rdfs:subClassOf :Mammal .

:hasOwner a owl:ObjectProperty .
